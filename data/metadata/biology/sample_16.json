    {
      "end": "00:01:31.300",
      "start": "00:01:29.467",
      "text": " To find their food."
    },
    {
      "end": "00:01:32.633",
      "start": "00:01:31.300",
      "text": " To mate."
    },
    {
      "end": "00:01:34.933",
      "start": "00:01:32.633",
      "text": " Or escaping from predators."
    },
    {
      "end": "00:01:36.667",
      "start": "00:01:34.933",
      "text": " With exception."
    },
    {
      "end": "00:01:38.800",
      "start": "00:01:36.667",
      "text": " See animal in corals."
    },
    {
      "end": "00:01:41.667",
      "start": "00:01:38.800",
      "text": " Our Cecil stay fixed in place."
    },
    {
      "end": "00:01:44.800",
      "start": "00:01:41.667",
      "text": " Animal kingdom is divided into two main divisions."
    },
    {
      "end": "00:01:46.900",
      "start": "00:01:44.800",
      "text": " Number one invertebrates."
    },
    {
      "end": "00:01:49.900",
      "start": "00:01:46.900",
      "text": " Which includes animals without backbone."
    },
    {
      "end": "00:01:51.833",
      "start": "00:01:49.900",
      "text": " Number two vertebrates."
    },
    {
      "end": "00:01:54.367",
      "start": "00:01:51.833",
      "text": " Which includes animals with backbone."
    },
    {
      "end": "00:01:57.333",
      "start": "00:01:54.367",
      "text": " Invertebrates is divided into many phyla."
    },
    {
      "end": "00:02:00.733",
      "start": "00:01:57.333",
      "text": " But only we will study one of them that is called arthropida."
    },
    {
      "end": "00:02:04.100",
      "start": "00:02:00.733",
      "text": " We will classify arthropida in the next slide."
    },
    {
      "end": "00:02:08.333",
      "start": "00:02:04.100",
      "text": " While vertebrates only includes one phylam, that is called cordata."
    },
    {
      "end": "00:02:12.867",
      "start": "00:02:08.333",
      "text": " Phylam cordata is subdivided into five classes at perting to the body covering."
    },
    {
      "end": "00:02:14.267",
      "start": "00:02:12.867",
      "text": " Class fish."
    },
    {
      "end": "00:02:16.333",
      "start": "00:02:14.267",
      "text": " With moist scales."
    },
    {
      "end": "00:02:17.900",
      "start": "00:02:16.333",
      "text": " Class amphibia."
    },
    {
      "end": "00:02:20.200",
      "start": "00:02:17.900",
      "text": " With naked scaleless skin."
    },
    {
      "end": "00:02:21.800",
      "start": "00:02:20.200",
      "text": " Class reptiles."
    },
    {
      "end": "00:02:23.700",
      "start": "00:02:21.800",
      "text": " With dry scales."
    },
    {
      "end": "00:02:25.133",
      "start": "00:02:23.700",
      "text": " Class birds."
    },
    {
      "end": "00:02:26.867",
      "start": "00:02:25.133",
      "text": " With feathers."
    },
    {
      "end": "00:02:28.400",
      "start": "00:02:26.867",
      "text": " Class mammals."
    },
    {
      "end": "00:02:38.800",
      "start": "00:02:28.400",
      "text": " With hair or fur."
    },
    {
      "end": "00:02:40.533",
      "start": "00:02:38.800",
      "text": " Phylam arthropida."
    },
    {
      "end": "00:02:42.800",
      "start": "00:02:40.533",
      "text": " Arthro means jointed."
    },
    {
      "end": "00:02:44.667",
      "start": "00:02:42.800",
      "text": " Clients mean legs."
    },
    {
      "end": "00:02:49.067",
      "start": "00:02:44.667",
      "text": " So arthropida is literally means animals with jointed legs."
    },
    {
      "end": "00:02:53.900",
      "start": "00:02:49.067",
      "text": " Phylam arthropida is divided into four classes according the number of legs."
    },
    {
      "end": "00:02:55.633",
      "start": "00:02:53.900",
      "text": " Class insect."
    },
    {
      "end": "00:02:59.900",
      "start": "00:02:55.633",
      "text": " With three pairs of jointed legs, that means six legs."
    },
    {
      "end": "00:03:01.633",
      "start": "00:02:59.900",
      "text": " Class arachnid."
    },
    {
      "end": "00:03:05.633",
      "start": "00:03:01.633",
      "text": " With four pairs of jointed legs that means eight legs."
    },
    {
      "end": "00:03:07.600",
      "start": "00:03:05.633",
      "text": " Class crustacea."
    },
    {
      "end": "00:03:11.000",
      "start": "00:03:07.600",
      "text": " With more than four pairs of jointed legs."
    },
    {
      "end": "00:03:12.900",
      "start": "00:03:11.000",
      "text": " Class myriapida."
    },
    {
      "end": "00:03:20.800",
      "start": "00:03:12.900",
      "text": " Each segment of their body has one or two pairs of jointed legs."
    },
    {
      "end": "00:03:21.800",
      "start": "00:03:20.800",
      "text": " Dear."
    },
    {
      "end": "00:03:23.500",
      "start": "00:03:21.800",
      "text": " Please notice."
    },
    {
      "end": "00:03:27.433",
      "start": "00:03:23.500",
      "text": " That animal that belongs to phylaminella looks like animals of arthropida, but they have"
    },
    {
      "end": "00:03:30.900",
      "start": "00:03:27.433",
      "text": " no jointed legs."
    },
    {
      "end": "00:03:31.800",
      "start": "00:03:30.900",
      "text": " Thank you for watching."
    }

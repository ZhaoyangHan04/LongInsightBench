      "text": " حائد روزن"
    },
    {
      "end": "00:03:54.167",
      "start": "00:03:53.167",
      "text": " اکسیزن دیگو چھتو"
    },
    {
      "end": "00:03:55.167",
      "start": "00:03:54.167",
      "text": " ایگل ایگل"
    },
    {
      "end": "00:03:56.167",
      "start": "00:03:55.167",
      "text": " ایگل"
    },

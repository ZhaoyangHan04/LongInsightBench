      "end": "00:02:57.100",
      "start": "00:02:56.100",
      "text": " گلوکوز تھا کھائی"
    },
    {
      "end": "00:02:58.600",
      "start": "00:02:57.100",
      "text": " ایراؤچھے ایک شورک کرا"
    },
    {
      "end": "00:02:59.900",
      "start": "00:02:58.600",
      "text": " دیش شورک کرا"
    },
    {
      "end": "00:03:01.367",
      "start": "00:02:59.900",
      "text": " دیش حب درار تو ہوتھے"
    },
    {
      "end": "00:03:02.367",
      "start": "00:03:01.367",
      "text": " دوی"
    },
    {
      "end": "00:03:03.900",
      "start": "00:03:02.367",
      "text": " و اکھتا جادر اونو تھی"
    },
    {
      "end": "00:03:05.133",
      "start": "00:03:03.900",
      "text": " دویٹی اونو آچھے"
    },
    {
      "end": "00:03:06.567",
      "start": "00:03:05.133",
      "text": " جادر دوی اونو بیسٹو"
    },
    {
      "end": "00:03:08.700",
      "start": "00:03:06.567",
      "text": " تادر کے دیش شورک کرا با باہا ہوئے تھا کھائی"
    },
    {
      "end": "00:03:09.533",
      "start": "00:03:08.700",
      "text": " شکروز"
    },
    {
      "end": "00:03:10.533",
      "start": "00:03:09.533",
      "text": " لیکٹوز"
    },
    {
      "end": "00:03:11.933",
      "start": "00:03:10.533",
      "text": " ایراؤچھے دیش شورک کرا"
    },
    {
      "end": "00:03:12.567",
      "start": "00:03:11.933",
      "text": " چینی"
    },
    {
      "end": "00:03:13.267",
      "start": "00:03:12.567",
      "text": " دود"
    },
    {
      "end": "00:03:14.367",
      "start": "00:03:13.267",
      "text": " ایج شورک کرا"
    },
    {
      "end": "00:03:16.367",
      "start": "00:03:14.367",
      "text": " دیش شورک کرا پیتھا کھی"
    },
    {
      "end": "00:03:17.967",
      "start": "00:03:16.367",
      "text": " بوھو شورک کرا"
    },
    {
      "end": "00:03:19.400",
      "start": "00:03:17.967",
      "text": " بوھو مانی کی"
    },
    {
      "end": "00:03:20.367",
      "start": "00:03:19.400",
      "text": " ایک ایراؤچھے"
    },
    {
      "end": "00:03:21.333",
      "start": "00:03:20.367",
      "text": " با دوی روچھے"
    },
    {
      "end": "00:03:22.367",
      "start": "00:03:21.333",
      "text": " پین چار پاچھ"
    },
    {
      "end": "00:03:23.967",
      "start": "00:03:22.367",
      "text": " اونو بیسٹو تھا کھی"
    },
    {
      "end": "00:03:25.000",
      "start": "00:03:23.967",
      "text": " تادر کے بوھو شورک کرا"
    },
    {
      "end": "00:03:26.167",
      "start": "00:03:25.000",
      "text": " باہا ہوئے تھا کھی"
    },
    {
      "end": "00:03:26.967",
      "start": "00:03:26.167",
      "text": " شیتو شار"
    },
    {
      "end": "00:03:27.967",
      "start": "00:03:26.967",
      "text": " گلائکوز این"
    },
    {
      "end": "00:03:29.800",
      "start": "00:03:27.967",
      "text": " ایگلوکوز تھا بوھو شورک کرا"
    },
    {
      "end": "00:03:30.500",
      "start": "00:03:29.800",
      "text": " چال"
    },
    {
      "end": "00:03:30.967",
      "start": "00:03:30.500",
      "text": " آتا"
    },
    {
      "end": "00:03:31.500",
      "start": "00:03:30.967",
      "text": " آلو"
    },
    {
      "end": "00:03:33.233",
      "start": "00:03:31.500",
      "text": " ایتا دیش شورک کرا"
    },
    {
      "end": "00:03:34.233",
      "start": "00:03:33.233",
      "text": " ایچ شور"
    },
    {
      "end": "00:03:35.167",
      "start": "00:03:34.233",
      "text": " مانوک دھے"
    },
    {
      "end": "00:03:35.967",
      "start": "00:03:35.167",
      "text": " شورک کرا"
    },
    {
      "end": "00:03:37.167",
      "start": "00:03:35.967",
      "text": " شوشون کرتے پارے"
    },
    {
      "end": "00:03:38.167",
      "start": "00:03:37.167",
      "text": " آتا رہی دیش"
    },
    {
      "end": "00:03:39.167",
      "start": "00:03:38.167",
      "text": " باہتری شورک کرا"
    },
    {
      "end": "00:03:40.167",
      "start": "00:03:39.167",
      "text": " باہو شورک کرا"
    },
    {
      "end": "00:03:41.167",
      "start": "00:03:40.167",
      "text": " مانوک دھو شورک کرتے"
    },
    {
      "end": "00:03:42.167",
      "start": "00:03:41.167",
      "text": " پارے مان"
    },
    {
      "end": "00:03:43.167",
      "start": "00:03:42.167",
      "text": " امرہ اریکٹا"
    },
    {
      "end": "00:03:44.167",
      "start": "00:03:43.167",
      "text": " او پادن"
    },
    {
      "end": "00:03:45.167",
      "start": "00:03:44.167",
      "text": " شمپور کے جانبو"
    },
    {
      "end": "00:03:46.167",
      "start": "00:03:45.167",
      "text": " تاہوچھے"
    },
    {
      "end": "00:03:47.167",
      "start": "00:03:46.167",
      "text": " نی ہو جاتی ہو"
    },
    {
      "end": "00:03:48.167",
      "start": "00:03:47.167",
      "text": " پادتھو"
    },
    {
      "end": "00:03:49.167",
      "start": "00:03:48.167",
      "text": " نی ہو جاتی ہو"
    },
    {
      "end": "00:03:50.167",
      "start": "00:03:49.167",
      "text": " تا رہا"
    },
    {
      "end": "00:03:51.167",

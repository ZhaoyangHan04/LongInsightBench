      "end": "00:00:34.000",
      "start": "00:00:32.000",
      "text": " We are still both train killers."
    },
    {
      "end": "00:00:40.000",
      "start": "00:00:38.000",
      "text": " We have unfinished business."
    },
    {
      "end": "00:00:42.000",
      "start": "00:00:40.000",
      "text": " Is we?"
    },
    {
      "end": "00:00:52.000",
      "start": "00:00:48.000",
      "text": " Still fits."
    },
    {
      "end": "00:00:54.000",
      "start": "00:00:52.000",
      "text": " Family."
    },
    {
      "end": "00:00:56.000",
      "start": "00:00:54.000",
      "text": " We're together again."
    },
    {
      "end": "00:00:58.000",
      "start": "00:00:56.000",
      "text": " You got fat."
    },
    {
      "end": "00:01:00.000",
      "start": "00:00:58.000",
      "text": " It's mainly waterway."
    },
    {
      "end": "00:01:06.000",
      "start": "00:01:02.000",
      "text": " There's a new world of widows."
    },
    {
      "end": "00:01:08.000",
      "start": "00:01:06.000",
      "text": " New enemies."
    },
    {
      "end": "00:01:12.000",
      "start": "00:01:10.000",
      "text": " I'm done running for my past."
    },
    {
      "end": "00:01:26.000",
      "start": "00:01:24.000",
      "text": " That was that guy."
    },
    {
      "end": "00:01:56.000",

      "end": "00:00:24.983",
      "start": "00:00:23.982",
      "text": " He knows his daddy."
    },
    {
      "end": "00:00:25.984",
      "start": "00:00:24.983",
      "text": " He knows his daddy."
    },
    {
      "end": "00:00:26.985",
      "start": "00:00:25.984",
      "text": " He knows his daddy."
    },
    {
      "end": "00:00:27.986",
      "start": "00:00:26.985",
      "text": " He knows his daddy."
    },
    {
      "end": "00:00:28.987",
      "start": "00:00:27.986",
      "text": " He knows his daddy."
    },
    {
      "end": "00:00:30.989",
      "start": "00:00:28.987",
      "text": " He knows his daddy protects people."
    },
    {
      "end": "00:00:32.991",
      "start": "00:00:30.989",
      "text": " He will cat and mouse with you."
    },
    {
      "end": "00:00:34.993",
      "start": "00:00:32.991",
      "text": " He will make you think you are getting somewhere."
    },
    {
      "end": "00:00:35.994",
      "start": "00:00:34.993",
      "text": " Press record."
    },
    {
      "end": "00:00:37.996",
      "start": "00:00:35.994",
      "text": " Let's get this party started."
    },
    {
      "end": "00:00:40.999",
      "start": "00:00:37.996",
      "text": " It is February 13th, 1986."
    },
    {
      "end": "00:00:42.960",
      "start": "00:00:40.999",
      "text": " This is Agent Bill Hagmler."
    },
    {
      "end": "00:00:43.961",
      "start": "00:00:42.960",
      "text": " I'm sitting with Theodore."
    },
    {
      "end": "00:00:44.962",
      "start": "00:00:43.961",
      "text": " Look Ted."
    },
    {
      "end": "00:00:46.964",
      "start": "00:00:44.962",
      "text": " I'm sitting with Ted Bundy."
    },
    {
      "end": "00:00:49.967",
      "start": "00:00:46.964",
      "text": " Ted Bundy has 13 hours to live."
    },
    {
      "end": "00:00:52.970",
      "start": "00:00:49.967",
      "text": " And he is using those hours to try and buy himself more time."
    },
    {
      "end": "00:00:54.972",
      "start": "00:00:52.970",
      "text": " He's ready to talk."
    },
    {
      "end": "00:00:57.975",
      "start": "00:00:54.972",
      "text": " He's ready to confess everything, but only talk to one person."
    },
    {
      "end": "00:00:59.977",
      "start": "00:00:57.975",
      "text": " Their family is out there looking for answers."
    },
    {
      "end": "00:01:02.980",
      "start": "00:00:59.977",
      "text": " The world needs to know why he killed those girls."
    },
    {
      "end": "00:01:04.982",
      "start": "00:01:02.980",
      "text": " You're some hot shot young upstarting."
    },
    {
      "end": "00:01:05.983",
      "start": "00:01:04.982",
      "text": " I'm your next big case."
    },
    {
      "end": "00:01:07.985",
      "start": "00:01:05.983",
      "text": " You're going to be the guy who broke me."
    },
    {
      "end": "00:01:11.989",
      "start": "00:01:07.985",
      "text": " There are a lot of myths and misunderstandings about me."
    },
    {
      "end": "00:01:13.991",
      "start": "00:01:11.989",
      "text": " What are you going to tell me?"
    },
    {
      "end": "00:01:15.993",
      "start": "00:01:13.991",
      "text": " Everything."
    },
    {
      "end": "00:01:17.995",
      "start": "00:01:15.993",
      "text": " What do you think you want?"
    },
    {
      "end": "00:01:19.997",
      "start": "00:01:17.995",
      "text": " You and I will sit down and have the conversation."
    },
    {
      "end": "00:01:20.998",
      "start": "00:01:19.997",
      "text": " You've wanted this whole time."
    },
    {
      "end": "00:01:24.960",
      "start": "00:01:20.998",
      "text": " When you get too close to a guy like this, you can lose your way."
    },
    {
      "end": "00:01:25.961",
      "start": "00:01:24.960",
      "text": " Do you think you could kill someone?"
    },
    {
      "end": "00:01:27.963",
      "start": "00:01:25.961",
      "text": " I'm an FBI agent."
    },
    {
      "end": "00:01:29.965",
      "start": "00:01:27.963",
      "text": " That's not what I'm saying."
    },
    {
      "end": "00:01:31.967",
      "start": "00:01:29.965",
      "text": " You can't hold these girls hostage."
    },
    {
      "end": "00:01:32.968",
      "start": "00:01:31.967",
      "text": " I'm not playing games."
    },
    {
      "end": "00:01:33.969",
      "start": "00:01:32.968",
      "text": " How many did you kill?"
    },
    {
      "end": "00:01:34.970",
      "start": "00:01:33.969",
      "text": " Let's say 30."
    },
    {
      "end": "00:01:35.971",
      "start": "00:01:34.970",
      "text": " Let's say we talk about the real number."
    },
    {
      "end": "00:01:37.973",
      "start": "00:01:35.971",
      "text": " 30 is a nice red number."
    },
    {
      "end": "00:01:39.975",
      "start": "00:01:37.973",
      "text": " You're getting inside my head."
    },
    {
      "end": "00:01:41.977",
      "start": "00:01:39.975",
      "text": " I'm looking for understanding."
    },
    {
      "end": "00:01:42.978",
      "start": "00:01:41.977",
      "text": " You think they should kill me, don't you?"
    },
    {
      "end": "00:01:44.980",
      "start": "00:01:42.978",
      "text": " You think it's my time to die?"
    },
    {
      "end": "00:01:46.982",
      "start": "00:01:44.980",
      "text": " Frankly, they probably should have done it a long time ago."
    },
    {
      "end": "00:01:52.988",
      "start": "00:01:46.982",
      "text": " I'm going to take you somewhere that I've never taken anyone before."
    },
    {
      "end": "00:01:57.993",
      "start": "00:01:55.991",
      "text": " I need a modern book."
    },
    {
      "end": "00:01:59.995",
      "start": "00:01:57.993",
      "text": " He's my best friend."
    }

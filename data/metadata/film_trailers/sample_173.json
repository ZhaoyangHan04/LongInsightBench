    },
    {
      "end": "00:00:28.070",
      "start": "00:00:26.777",
      "text": " Tell me a story"
    },
    {
      "end": "00:00:30.072",
      "start": "00:00:28.070",
      "text": " in any language you want."
    },
    {
      "end": "00:00:33.075",
      "start": "00:00:32.074",
      "text": " Tolkien!"
    },
    {
      "end": "00:00:35.077",
      "start": "00:00:33.075",
      "text": " What's about Jair's?"
    },
    {
      "end": "00:00:39.081",
      "start": "00:00:36.078",
      "text": " The journeys we take to prove ourselves."
    },
    {
      "end": "00:00:42.084",
      "start": "00:00:41.083",
      "text": " What's about the adventures?"
    },
    {
      "end": "00:00:45.087",
      "start": "00:00:42.084",
      "text": " We should form a club, a brotherhood."
    },
    {
      "end": "00:00:48.090",
      "start": "00:00:45.087",
      "text": " We change the world through the power of art."
    },
    {
      "end": "00:00:51.093",
      "start": "00:00:48.090",
      "text": " Music, poetry, and what about Tolkien?"
    },
    {
      "end": "00:00:53.095",
      "start": "00:00:51.093",
      "text": " I want to write something."
    },
    {
      "end": "00:00:56.098",
      "start": "00:00:53.095",
      "text": " It's about magic beyond anything anyone has ever felt before."
    },
    {
      "end": "00:01:00.060",
      "start": "00:00:58.100",
      "text": " What it means to love."
    },
    {
      "end": "00:01:02.062",
      "start": "00:01:00.060",
      "text": " To be loved."
    },
    {
      "end": "00:01:06.066",
      "start": "00:01:05.065",
      "text": " War!"
    },
    {
      "end": "00:01:08.068",
      "start": "00:01:06.066",
      "text": " It lands at war!"
    },
    {
      "end": "00:01:25.085",
      "start": "00:01:23.083",
      "text": " Tolkien!"
    },
    {
      "end": "00:01:29.089",
      "start": "00:01:26.086",
      "text": " Where are you?"
    },
    {
      "end": "00:01:31.091",
      "start": "00:01:29.089",
      "text": " All of the rhythms of language."
    },
    {
      "end": "00:01:33.093",
      "start": "00:01:31.091",
      "text": " I have to tell you Mr. Tolkien."
    },
    {
      "end": "00:01:36.096",
      "start": "00:01:33.093",
      "text": " I've never come across anything like it."
    },
    {
      "end": "00:01:44.062",
      "start": "00:01:42.060",
      "text": " This is more than just a friendship."
    },
    {
      "end": "00:01:46.064",
      "start": "00:01:44.062",
      "text": " It's an alliance."
    },
    {
      "end": "00:01:48.066",
      "start": "00:01:46.064",
      "text": " An invincible alliance."
    },
    {
      "end": "00:01:54.072",
      "start": "00:01:48.066",
      "text": " A fellowship."
    }

      "start": "00:01:13.433",
      "text": " We have peaches."
    },
    {
      "end": "00:01:24.000",
      "start": "00:01:14.867",
      "text": " We have apples and we have different widget tables."
    },
    {
      "end": "00:01:26.300",
      "start": "00:01:24.633",
      "text": " We have tomatoes these days."
    },
    {
      "end": "00:01:27.033",

  "text_to_speech": "using a compass is easy hold it flat parallel to the ground rotate until the needle aligns with the N mark That's North to find another Direction turn your body until the desired degree aligns with the direction of travel Arrow Follow the arrow to stay on course remember to account for declination in your area happy navigating",
  "text_to_speech_word_count": 58,
  "timecoded_text_to_speech": [
    {
      "end": "00:00:02.000",
      "start": "00:00:00.000",
      "text": " Using a compass is easy."
    },
    {
      "end": "00:00:05.000",
      "start": "00:00:02.500",
      "text": " Hold it flat, parallel to the ground."
    },
    {
      "end": "00:00:08.500",
      "start": "00:00:05.500",
      "text": " Rotate until the needle aligns with the end mark."
    },
    {
      "end": "00:00:10.500",
      "start": "00:00:09.000",
      "text": " That's north."
    },
    {
      "end": "00:00:16.500",
      "start": "00:00:11.000",
      "text": " To find another direction, turn your body until the desired degree aligns with the direction of travel arrow."
    },
    {
      "end": "00:00:19.500",
      "start": "00:00:17.000",
      "text": " Follow the arrow to stay on course."
    },
    {
      "end": "00:00:23.000",
      "start": "00:00:20.000",
      "text": " Remember to account for declination in your area."
    },
    {
      "end": "00:00:25.000",
      "start": "00:00:23.500",
      "text": " Happy Navigating!"
    }
  ],

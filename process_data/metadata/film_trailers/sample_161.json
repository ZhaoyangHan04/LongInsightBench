    },
    {
      "end": "00:00:12.000",
      "start": "00:00:10.000",
      "text": " Just a few souvenirs."
    },
    {
      "end": "00:00:17.000",
      "start": "00:00:14.000",
      "text": " You served eight months for accessory to murder."
    },
    {
      "end": "00:00:20.000",
      "start": "00:00:17.000",
      "text": " Do you feel you've been rehabilitated?"
    },
    {
      "end": "00:00:23.000",
      "start": "00:00:20.000",
      "text": " Oh yeah, I'm a changed man."
    },
    {
      "end": "00:00:25.000",
      "start": "00:00:23.000",
      "text": " So as I'm an ex-patient then,"
    },
    {
      "end": "00:00:30.000",
      "start": "00:00:26.000",
      "text": " our service is for people who are dying to the finale."
    },
    {
      "end": "00:00:33.000",
      "start": "00:00:32.000",
      "text": " About Mary Harris."
    },
    {
      "end": "00:00:36.000",
      "start": "00:00:33.000",
      "text": " You think about the case or you think about a woman?"
    },
    {
      "end": "00:00:38.000",
      "start": "00:00:36.000",
      "text": " My name is Des."
    },
    {
      "end": "00:00:39.000",
      "start": "00:00:38.000",
      "text": " Olivia."
    },
    {
      "end": "00:00:42.000",
      "start": "00:00:40.000",
      "text": " I know you kill people Des."
    },
    {
      "end": "00:00:45.000",
      "start": "00:00:43.000",
      "text": " I'm gonna need you to kill my husband."
    },
    {
      "end": "00:00:48.000",
      "start": "00:00:46.000",
      "text": " We're not going to help you."
    },
    {
      "end": "00:00:49.000",
      "start": "00:00:48.000",
      "text": " Excuse me?"
    },
    {
      "end": "00:00:51.000",
      "start": "00:00:49.000",
      "text": " You ever mess with me?"
    },
    {
      "end": "00:00:52.000",
      "start": "00:00:51.000",
      "text": " I'm not kidding."
    },
    {
      "end": "00:00:54.000",
      "start": "00:00:52.000",
      "text": " My name is Mary."
    },
    {
      "end": "00:00:57.000",
      "start": "00:00:55.000",
      "text": " Daddy, no!"
    },
    {
      "end": "00:00:59.000",
      "start": "00:00:57.000",
      "text": " I know you're off of pushing boundaries."
    },
    {
      "end": "00:01:02.000",
      "start": "00:00:59.000",
      "text": " There are some boundaries that they don't need pushing."
    },
    {
      "end": "00:01:03.000",
      "start": "00:01:02.000",
      "text": " I'm ready."
    },
    {
      "end": "00:01:05.000",
      "start": "00:01:03.000",
      "text": " You want to help people?"
    },
    {
      "end": "00:01:07.000",
      "start": "00:01:05.000",
      "text": " Like who is helping you?"
    },
    {
      "end": "00:01:09.000",
      "start": "00:01:07.000",
      "text": " You're gonna kill my husband."
    },
    {
      "end": "00:01:11.000",
      "start": "00:01:09.000",
      "text": " I'm not going to do that."
    },
    {
      "end": "00:01:12.000",
      "start": "00:01:11.000",
      "text": " I think you are."
    },
    {
      "end": "00:01:16.000",
      "start": "00:01:15.000",
      "text": " You were saying?"
    },
    {
      "end": "00:01:18.000",
      "start": "00:01:17.000",
      "text": " Whether you believe it or not,"
    },
    {
      "end": "00:01:20.000",
      "start": "00:01:18.000",
      "text": " you brought yourself to this moment."
    },
    {
      "end": "00:01:23.000",
      "start": "00:01:20.000",
      "text": " I don't think we should only help people when it's easy for us."
    },
    {
      "end": "00:01:25.000",
      "start": "00:01:23.000",
      "text": " We also have to be able to sleep at night."
    },
    {
      "end": "00:01:26.000",
      "start": "00:01:25.000",
      "text": " I sleep for..."
    },
    {
      "end": "00:01:31.000",
      "start": "00:01:28.000",
      "text": " You're a different person for ending this."
    }

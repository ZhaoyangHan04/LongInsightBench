      "text": " Hey, get out of there!"
    },
    {
      "end": "00:01:14.992",
      "start": "00:01:12.990",
      "text": " That dog saved his life."
    },
    {
      "end": "00:01:23.000",
      "start": "00:01:20.998",
      "text": " Hey, look, a doggy bag."
    },
    {
      "end": "00:01:29.965",
      "start": "00:01:25.961",
      "text": " I discovered that every challenge I met, every fear I faced."

      "start": "00:03:49.000",
      "text": " Isn't that the mission?"
    },
    {
      "end": "00:03:51.000",
      "start": "00:03:50.000",
      "text": " Isn't that the why we fight?"
    },
    {
      "end": "00:03:52.000",
      "start": "00:03:51.000",
      "text": " So we can end the fight?"

    },
    {
      "end": "00:00:19.000",
      "start": "00:00:18.320",
      "text": " நாங்குத் தெளிவு"
    },
    {
      "end": "00:00:21.920",
      "start": "00:00:20.120",
      "text": " அப்போது பேச்சில் ஒரு சிட்சின் கட்னும்"
    },
    {
      "end": "00:00:23.920",
      "start": "00:00:21.920",
      "text": " அது சாலர் நம்மணவிஷியமாயிருக்கப் போருத்தில்"
    },
    {
      "end": "00:00:24.560",
      "start": "00:00:23.920",
      "text": " சூ்யும்"
    },
    {
      "end": "00:00:25.640",
      "start": "00:00:24.560",
      "text": " உணிட்டையைச் சுடைய"
    },
    {
      "end": "00:00:26.200",
      "start": "00:00:25.640",
      "text": " நாஸா"
    },
    {
      "end": "00:00:27.400",
      "start": "00:00:26.200",
      "text": " ரசியாவுடன் ரசகசமுச"
    },
    {
      "end": "00:00:28.600",
      "start": "00:00:27.400",
      "text": " ஜாப்பனவுடன் ஜாகசா"
    },
    {
      "end": "00:00:29.360",
      "start": "00:00:28.600",
      "text": " ஊரப்போடன்"
    },
    {
      "end": "00:00:30.080",
      "start": "00:00:29.360",
      "text": " ஏசே"
    },
    {
      "end": "00:00:31.160",
      "start": "00:00:30.080",
      "text": " கணடவுடன் சியசே"
    },
    {
      "end": "00:00:32.800",
      "start": "00:00:31.160",
      "text": " இந்த அஞ்சி ஜன்சிசாவடன் சேந்து"
    },
    {
      "end": "00:00:34.320",
      "start": "00:00:32.800",
      "text": " யாரோ பியப் பின்பில ஜன்சியவுடன்"
    },
    {
      "end": "00:00:35.840",
      "start": "00:00:34.320",
      "text": " பலனோரு உருப்பு நாடுகளானே"
    },
    {
      "end": "00:00:36.720",
      "start": "00:00:35.840",
      "text": " வெள்ஜியம்,"
    },
    {
      "end": "00:00:37.280",
      "start": "00:00:36.720",
      "text": " தேன்மார்,"
    },
    {
      "end": "00:00:38.400",
      "start": "00:00:37.280",
      "text": " திரமானி,"
    },
    {
      "end": "00:00:39.680",
      "start": "00:00:38.400",
      "text": " திரும்பும் நாதல்லன்"
    },
    {
      "end": "00:00:40.280",
      "start": "00:00:39.680",
      "text": " நார்வே,"
    },
    {
      "end": "00:00:41.960",
      "start": "00:00:40.280",
      "text": " சியின், சியதலன், சியதலன்,"
    },
    {
      "end": "00:00:43.120",
      "start": "00:00:41.960",
      "text": " அப்போது ஜன்சியவுக்கே"
    },
    {
      "end": "00:00:45.680",
      "start": "00:00:43.120",
      "text": " இப்படி இத்திரன்னாடுகளுடன் கூட்டுமையிருக்கி"
    },
    {
      "end": "00:00:47.040",
      "start": "00:00:45.680",
      "text": " அப்படியென்று உடிப்பாளை இந்த"
    },
    {
      "end": "00:00:48.560",
      "start": "00:00:47.040",
      "text": " சپேச் பிறகும் பணிருக்கும் பணிருக்கிறார்கள்"
    },
    {
      "end": "00:00:50.080",
      "start": "00:00:48.560",
      "text": " இந்த சபேச்சியத்தியத்துவிட்டு"
    },
    {
      "end": "00:00:50.680",
      "start": "00:00:50.080",
      "text": " சாயத்தியத்து"
    },
    {
      "end": "00:00:51.680",
      "start": "00:00:50.680",
      "text": " ஒரு குழ்ப்புள் பிள்ளிடுடன்"
    },
    {
      "end": "00:00:52.680",
      "start": "00:00:51.680",
      "text": " கொஞ்சு பிரசாவே இருக்கும்"
    },
    {
      "end": "00:00:53.800",
      "start": "00:00:52.680",
      "text": " அதனால்து"
    },
    {
      "end": "00:00:54.760",
      "start": "00:00:53.800",
      "text": " இரத்தில்துக்கு"
    },
    {
      "end": "00:00:55.960",
      "start": "00:00:54.760",
      "text": " அலைக்காத்துக்கொள்ளுக்கும் முடியது என்றால்"
    },
    {
      "end": "00:00:57.440",
      "start": "00:00:55.960",
      "text": " நாடுக்கும் கொஞ்சுக்கும் கொஞ்சுக்கும் பாத்தான்"
    },
    {
      "end": "00:00:57.880",
      "start": "00:00:57.440",
      "text": " சபேச்சுக்கும்"
    },
    {
      "end": "00:00:58.680",
      "start": "00:00:57.880",
      "text": "லாஜ்பனி"
    },
    {
      "end": "00:00:59.880",
      "start": "00:00:58.680",
      "text": " சபேச்சலையையைத்து"
    },
    {
      "end": "00:01:00.880",
      "start": "00:00:59.880",
      "text": " சபேச்சலையையைத்துக்கு"
    },
    {
      "end": "00:01:01.880",
      "start": "00:01:00.880",
      "text": " நட்டுபோட்டில்தில் தின்னுடன் கொடுக்கிற்கு"
    },
    {
      "end": "00:01:02.880",
      "start": "00:01:01.880",
      "text": " திரும்பத்திருக்காக்காக்காக"
    },
    {
      "end": "00:01:03.880",
      "start": "00:01:02.880",
      "text": " இந்த சபேச்சித்துக்கொள்ளுடன்"
    },
    {
      "end": "00:01:04.880",
      "start": "00:01:03.880",
      "text": " திரும்பது"
    },
    {
      "end": "00:01:05.880",
      "start": "00:01:04.880",
      "text": " அதாவது"
    },
    {
      "end": "00:01:06.880",
      "start": "00:01:05.880",
      "text": " திரும்பது"
    },
    {
      "end": "00:01:07.880",
      "start": "00:01:06.880",
      "text": " மோடிவு"
    },
    {
      "end": "00:01:09.880",
      "start": "00:01:07.880",
      "text": " ஜாரியவு"
    },
    {
      "end": "00:01:11.880",
      "start": "00:01:09.880",
      "text": " நாம்பத்திற்கும் 90-98்லா"
    },
    {
      "end": "00:01:12.880",
      "start": "00:01:11.880",
      "text": " ஜாரியவு"
    },
    {
      "end": "00:01:13.880",
      "start": "00:01:12.880",
      "text": "லாஜ்ஸ்னானதுக்கு"
    },
    {
      "end": "00:01:14.880",
      "start": "00:01:13.880",
      "text": " இரண்டு வாரத்துக்கப் பிறகு"
    },
    {
      "end": "00:01:15.880",
      "start": "00:01:14.880",
      "text": "ஸ்டியத் திரும்மிஷ்ஷ்ஷட்டு"
    },
    {
      "end": "00:01:16.880",
      "start": "00:01:15.880",
      "text": " மிகவும் முளம்மா"
    },
    {
      "end": "00:01:17.880",
      "start": "00:01:16.880",
      "text": " திரும்பது"
    },
    {
      "end": "00:01:18.880",
      "start": "00:01:17.880",
      "text": " மோடில் சங்கிரம் பார்ட்டாய்"
    },
    {
      "end": "00:01:19.880",
      "start": "00:01:18.880",
      "text": "லாஜ்பனாக"
    },
    {
      "end": "00:01:20.880",
      "start": "00:01:19.880",
      "text": " நோட் மோடில் சங்கிருது"
    },
    {
      "end": "00:01:21.880",
      "start": "00:01:20.880",
      "text": " ஒரு தோர் மாதிரி"
    },
    {
      "end": "00:01:22.880",
      "start": "00:01:21.880",
      "text": " அதைல்லாகப் பண்லா"
    },
    {
      "end": "00:01:23.880",
      "start": "00:01:22.880",
      "text": " ஓப்பன் பண்லா"
    },
    {
      "end": "00:01:25.880",
      "start": "00:01:23.880",
      "text": " ராஜ்பன் பண்ணாக"
    },
    {
      "end": "00:01:26.880",
      "start": "00:01:25.880",
      "text": " இரண்டு வருத்துக்கப் பண்ணாக"
    },
    {
      "end": "00:01:27.880",
      "start": "00:01:26.880",
      "text": " மன்ச்சங்கத் தங்கி"
    },
    {
      "end": "00:01:28.880",
      "start": "00:01:27.880",
      "text": " ராஜிப்பன் இருக்கு"
    },
    {
      "end": "00:01:30.880",
      "start": "00:01:29.880",
      "text": " முதல் முரியா"
    },
    {
      "end": "00:01:31.880",
      "start": "00:01:30.880",
      "text": " முன்னனப்பிரில் கொண்ட"
    },
    {
      "end": "00:01:32.880",
      "start": "00:01:31.880",
      "text": " ஒரு குழுவச் சபயத்திச்சின்"
    },
    {
      "end": "00:01:33.880",
      "start": "00:01:32.880",
      "text": " காண்பம் முடியுப்பன்றான்"
    },
    {
      "end": "00:01:34.880",
      "start": "00:01:33.880",
      "text": " இந்த மிஷன்கு"
    },
    {
      "end": "00:01:35.880",
      "start": "00:01:34.880",
      "text": " எங்கு எங்கு எங்கு எங்கு எங்கு எங்கு"
    },
    {
      "end": "00:01:36.880",
      "start": "00:01:35.880",
      "text": " ஒன்னின் பேர்வைத்தான்"
    },
    {
      "end": "00:01:37.880",
      "start": "00:01:36.880",
      "text": " இதுதான் நீண்டு காளம்"
    },
    {
      "end": "00:01:38.880",
      "start": "00:01:37.880",
      "text": " சபயத்திச்சின்றில்"
    },
    {
      "end": "00:01:39.880",
      "start": "00:01:38.880",
      "text": " தங்கரித்துக்கான"
    },
    {
      "end": "00:01:41.880",
      "start": "00:01:40.880",
      "text": " இதுதான்"
    },
    {
      "end": "00:01:42.880",
      "start": "00:01:41.880",
      "text": " சபயத்திச்சின்றில்"
    },
    {
      "end": "00:01:43.880",
      "start": "00:01:42.880",
      "text": " மன்சிங்களோடு பிரச்சின்ற"
    },
    {
      "end": "00:01:44.880",
      "start": "00:01:43.880",
      "text": " தடையில்லாமல் வைத்திக்கொடுக்கான"
    },
    {
      "end": "00:01:45.880",
      "start": "00:01:44.880",
      "text": " முதல் படியாய இருந்தது"
    },
    {
      "end": "00:01:46.880",
      "start": "00:01:45.880",
      "text": " அதாவது நாம்பர் 2,000்று"
    },
    {
      "end": "00:01:47.880",
      "start": "00:01:46.880",
      "text": " மாஜ்சி 2,000்று"
    },
    {
      "end": "00:01:48.880",
      "start": "00:01:47.880",
      "text": " மாஜ்சி 2,000்று"
    },
    {
      "end": "00:01:49.880",
      "start": "00:01:48.880",
      "text": " இதுதான் சபயத்திச்சின்றில்"
    },
    {
      "end": "00:01:51.880",
      "start": "00:01:49.880",
      "text": " மன்சிங்களோடு பிரச்சின்ற"
    },
    {
      "end": "00:01:52.880",
      "start": "00:01:51.880",
      "text": " மன்சிங்களோடு பிரச்சின்றி"
    },
    {
      "end": "00:01:53.880",
      "start": "00:01:52.880",
      "text": " நாம்பர் 2,000்று"
    },
    {
      "end": "00:01:54.880",
      "start": "00:01:53.880",
      "text": " இப்போது"
    },
    {
      "end": "00:01:55.880",
      "start": "00:01:54.880",
      "text": " இப்போது"
    },
    {
      "end": "00:01:57.880",
      "start": "00:01:55.880",
      "text": " இப்புற் 2,000்று"
    },
    {
      "end": "00:01:59.880",
      "start": "00:01:57.880",
      "text": " மன்சிங்களோடு பிரச்சின்றில்"
    },
    {
      "end": "00:02:00.880",
      "start": "00:01:59.880",
      "text": " இதுதான் இருக்கும்"
    },
    {
      "end": "00:02:01.880",
      "start": "00:02:00.880",
      "text": " இப்போது"
    },
    {
      "end": "00:02:02.880",
      "start": "00:02:01.880",
      "text": " மன்சிங்களோடு பிரச்சின்றில்"
    },
    {
      "end": "00:02:03.880",
      "start": "00:02:02.880",
      "text": " மன்சிங்களோடு பிரச்சின்றில்"
    },
    {
      "end": "00:02:04.880",
      "start": "00:02:03.880",
      "text": " இந்த மன்சிங்களோடு பிரச்சின்றில்"
